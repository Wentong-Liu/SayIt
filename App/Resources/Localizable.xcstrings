    "general.interactionHint.singleTap" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the trigger key alone to start, tap again to stop. Holding it with another key (a shortcut) won’t trigger." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单独单击触发键开始录音，再次单击结束。与其它键同按（即快捷键）不会触发。" } }
      }
    },
    "general.interactionHint.toggle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the trigger key to start, tap again to stop." } },
