      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold the trigger key to record, release to stop." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住触发键开始录音，松开结束。" } }
