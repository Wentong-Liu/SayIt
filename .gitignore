# macOS
.DS_Store

# Xcode user-specific & build products
**/xcuserdata/
*.xcuserstate
DerivedData/
build/
**/build/

# XcodeGen output (project.yml is the single source of truth; generated
# project files are not committed)
*.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Temporary build products (e.g. /tmp derived-data dirs)
/tmp/sayit-dd/

# Speech models (WhisperKit etc. — too large to track)
Models/
*.mlmodelc
*.mlpackage

# Local diagnostic / scratch notes
.local-notes/

# Local, machine-specific signing config (holds your own DEVELOPMENT_TEAM).
# Copy Local.xcconfig.example to Local.xcconfig; see README.
Local.xcconfig
